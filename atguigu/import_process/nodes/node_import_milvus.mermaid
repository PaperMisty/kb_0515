---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef dbNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20;

    subgraph Main [NodeImportMilvus process 流程]
        Start(["开始: process state"])
        Step1("获取 state 中的 chunk_dict_list")
        Step2{"检查 chunk_dict_list 是否为空?"}
        Err_Chunks("抛出 ValueError 异常")
        Step3("获取向量维度并连接 Milvus 客户端")
        Step4{"集合 chunk_collection 是否存在?"}
        Step5("定义 Schema 架构与 dense/sparse 字段索引参数")
        Step6[("创建 Milvus 集合并构建索引")]
        Step7("获取当前文件标题 file_title 并进行字符转义")
        Step8[("删除 Milvus 集合中已存在的同名文件记录 (幂等性清理)")]
        Step9[("批量插入 chunks 向量数据到集合中")]
        Step10("从插入结果中抽取新产生的 ids 并回填给对应的 chunks")
        End(["返回更新 id 后的 chunk_dict_list"])

        Start --> Step1
        Step1 --> Step2
        Step2 -- 是 --> Err_Chunks
        Step2 -- 否 --> Step3
        Step3 --> Step4
        Step4 -- 否 --> Step5
        Step5 --> Step6
        Step6 --> Step7
        Step4 -- 是 --> Step7
        Step7 --> Step8
        Step8 --> Step9
        Step9 --> Step10
        Step10 --> End
        Err_Chunks -.-> End
    end

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step3,Step5,Step7,Step10 processNode;
    class Step2,Step4 decisionNode;
    class Err_Chunks errorNode;
    class Step6,Step8,Step9 dbNode;
