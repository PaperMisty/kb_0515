---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef dbNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20;

    subgraph Main [NodeItemNameRecognition process 主体识别流程]
        Start(["开始: process state"])
        Step1("获取 state 中的 chunk_dict_list 和 md_path")
        Step2{"输入字段或路径校验是否合格?"}
        Err_Val("抛出 ValueError 异常")
        Step3("调用 get_item_name 识别产品主体名称")
        Step4("调用 get_milvus_collection 初始化库连接并清理旧数据")
        Step5("调用 get_item_vecs 向量化主体名称并插入 Milvus 表")
        Step6("调用 write_chunk_json 更新 chunks 并覆写 json 磁盘文件")
        End(["返回更新主体名称后的 chunk_dict_list"])

        Start --> Step1
        Step1 --> Step2
        Step2 -- 否 --> Err_Val
        Step2 -- 是 --> Step3
        Step3 --> Step4
        Step4 --> Step5
        Step5 --> Step6
        Step6 --> End
        Err_Val -.-> End
    end

    subgraph Name_Identify [get_item_name 主体提取逻辑]
        direction TD
        ID_Slice("提取前 10 个 chunks 并截取 10000 字符")
        ID_LLM("初始化 LLM 并传入 ITEM_NAME_USER_PROMPT_TEMPLATE")
        ID_Invoke("调用大语言模型进行主体名称推理")
        ID_Check{"是否识别到合法主体名称?"}
        ID_Default("使用文件标题 file_title 作为默认主体名称")
        ID_Ret("返回确定后的 item_name")

        ID_Slice --> ID_LLM
        ID_LLM --> ID_Invoke
        ID_Invoke --> ID_Check
        ID_Check -- 否 --> ID_Default
        ID_Check -- 是 --> ID_Ret
        ID_Default --> ID_Ret
    end

    subgraph DB_Init [get_milvus_collection 初始化逻辑]
        direction TD
        DB_Conn("获取 Milvus 客户端")
        DB_Exist{"主体表 collection 是否存在?"}
        DB_Schema("定义 id / item_name / file_title 以及 1024 维 dense/sparse 字段")
        DB_Create[("创建 Milvus 集合并配置 IVF_FLAT & 稀疏倒排索引")]
        DB_Del[("加载集合并执行 SQL 防注入转义物理删除已有旧文件主体记录")]
        DB_Ret("返回客户端与集合名称")

        DB_Conn --> DB_Exist
        DB_Exist -- 否 --> DB_Schema
        DB_Schema --> DB_Create
        DB_Create --> DB_Del
        DB_Exist -- 是 --> DB_Del
        DB_Del --> DB_Ret
    end

    %% 模块交互连线
    Step3 -.-> ID_Slice
    ID_Ret -.-> Step3
    Step4 -.-> DB_Conn
    DB_Ret -.-> Step4

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step3,Step4,Step5,Step6,ID_Slice,ID_LLM,ID_Invoke,ID_Default,ID_Ret,DB_Conn,DB_Schema,DB_Ret processNode;
    class Step2,ID_Check,DB_Exist decisionNode;
    class Err_Val errorNode;
    class DB_Create,DB_Del dbNode;
