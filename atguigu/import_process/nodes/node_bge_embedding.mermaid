---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef algoNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20;

    subgraph Main [NodeBGEEmbedding process 向量化流程]
        Start(["开始: process state"])
        Step1("获取 state 中的 chunk_dict_list")
        Step2{"检查 chunk_dict_list 是否为空?"}
        Err_Chunks("抛出 ValueError 异常")
        Step3("调用批量文本向量化核心逻辑")
        Step4("解析并校验 md_path 路径")
        Step5("将丰富向量后的 chunks 数据格式化写入 json 文件")
        End(["返回更新后的 chunk_dict_list"])

        Start --> Step1
        Step1 --> Step2
        Step2 -- 是 --> Err_Chunks
        Step2 -- 否 --> Step3
        Step3 --> Step4
        Step4 --> Step5
        Step5 --> End
        Err_Chunks -.-> End
    end

    subgraph Batch_Embed [批量文本向量化核心逻辑]
        direction TD
        Loop_Start("开始按 batch_size = 10 循环遍历 chunks")
        RC_Concat("将 item_name 与 chunk_content 换行拼接为 content_list")
        RC_GetEmbed[("调用 BGE-M3 客户端生成 dense 与 sparse 向量")]
        RC_Assign("遍历当前批次 chunk，追加 dense & sparse 到属性字段中")
        Loop_End{"是否还有未处理完的批次?"}

        Loop_Start --> RC_Concat
        RC_Concat --> RC_GetEmbed
        RC_GetEmbed --> RC_Assign
        RC_Assign --> Loop_End
        Loop_End -- 是 --> Loop_Start
        Loop_End -- 否 --> RC_Done("批处理完成")
    end

    %% 模块交互连线
    Step3 -.-> Loop_Start
    RC_Done -.-> Step3

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step3,Step4,Step5,Loop_Start,RC_Concat,RC_Assign,RC_Done processNode;
    class Step2,Loop_End decisionNode;
    class Err_Chunks errorNode;
    class RC_GetEmbed algoNode;
