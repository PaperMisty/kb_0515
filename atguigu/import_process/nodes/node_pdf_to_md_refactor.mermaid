---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef dbNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20;

    subgraph Main [NodePDFToMD process 流程]
        Start(["开始: process state"])
        Step1("解析并校验输入状态 pdf_path 和 local_dir")
        Step2("委派 MineruPDFConverter 执行格式转换")
        Step3("读取目标 Markdown 文件的文本内容")
        End(["返回 pdf 解析后的 md_content 和 md_path"])

        Start --> Step1
        Step1 --> Step2
        Step2 --> Step3
        Step3 --> End
    end

    subgraph Converter [MineruPDFConverter 内部细节]
        direction TD
        RC_Apply("1. 申请上传: POST 请求获取 batch_id 和预签名 URL")
        RC_Upload("2. 直传文件: PUT 方式把 PDF 上传至预签名 URL")
        RC_Poll("3. 循环轮询: 轮询查询接口状态，直到其为 done")
        RC_Down("4. 下载 ZIP 包: 从 full_zip_url 下载解析结果 ZIP")
        RC_Extract("5. 解压缩: 清理历史目录并把 ZIP 解压到对应文件夹")
        RC_Rename("6. 重命名: 将解压出的 full.md 改名为 pdf_path.stem + .md")
        RC_Clean("7. 清理临时 zip 文件")
        RC_Ret("8. 返回 target_md 文件路径")

        RC_Apply --> RC_Upload
        RC_Upload --> RC_Poll
        RC_Poll --> RC_Down
        RC_Down --> RC_Extract
        RC_Extract --> RC_Rename
        RC_Rename --> RC_Clean
        RC_Clean --> RC_Ret
    end

    %% 模块交互连线
    Step2 -.-> RC_Apply
    RC_Ret -.-> Step2

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step2,Step3,RC_Apply,RC_Upload,RC_Poll,RC_Down,RC_Extract,RC_Rename,RC_Clean,RC_Ret processNode;
