---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;

    subgraph Main [NodeDocumentSplit process 流程]
        Start(["开始: process state"])
        Step1("调用 get_md_content 读取并标准化 md 文本")
        Step2("调用 split_section 按章节切分段落与细分 chunks")
        Step3("调用 save_chunks_json 将结果持久化为 json 文本")
        End(["返回切分后的 chunk_dict_list"])

        Start --> Step1
        Step1 --> Step2
        Step2 --> Step3
        Step3 --> End
    end

    subgraph Reading_Logic [get_md_content 文本获取逻辑]
        direction TD
        RD_Validate("读取并校验 md_path 是否有效")
        RD_Read{"文件是否有内容?"}
        RD_Empty("返回空并记录日志")
        RD_Title("确定 file_title，未传入则默认使用文件名 stem")
        RD_Normalize("标准化并统一换行符: \\r\\n -> \\n, \\n\\n -> \\n")
        RD_Split("以 \\n 切分返回 md_content_list 行列表")

        RD_Validate --> RD_Read
        RD_Read -- 无内容 --> RD_Empty
        RD_Read -- 有内容 --> RD_Title
        RD_Title --> RD_Normalize
        RD_Normalize --> RD_Split
    end

    subgraph Splitting_Logic [split_section 段落章节分割核心逻辑]
        direction TD
        SP_Loop("遍历 md_content_list 各行文本")
        SP_Fence{"是否匹配代码围栏?"}
        SP_State("转换 is_block 代码块标志状态")
        SP_CheckTitle{"非代码块 && (匹配 #{1,6} 标题 || 文件末尾)?"}
        SP_Slice("截取切片 section_list，用 \\n 拼接为 section_content")
        SP_Judge{"长度 < 300 或包含 HTML 表格 <table?"}
        SP_Direct("将整个章节内容封装为单个 chunk (part=0)")
        SP_Recurse("使用 RecursiveCharacterTextSplitter 进行递归文本切片 (chunk_size=300)")
        SP_Append("为切分块前缀增加章节标题，包装为 chunks 列表 (part=1,2...)")
        SP_Update("更新当前段落起始索引")

        SP_Loop --> SP_Fence
        SP_Fence -- 是 --> SP_State
        SP_Fence -- 否 --> SP_CheckTitle
        SP_State --> SP_CheckTitle
        SP_CheckTitle -- 是 --> SP_Slice
        SP_CheckTitle -- 否 --> SP_Loop
        SP_Slice --> SP_Judge
        SP_Judge -- 是 --> SP_Direct
        SP_Judge -- 否 --> SP_Recurse
        SP_Recurse --> SP_Append
        SP_Direct --> SP_Update
        SP_Append --> SP_Update
        SP_Update --> SP_Loop
    end

    %% 模块交互连线
    Step1 -.-> RD_Validate
    RD_Split -.-> Step1
    Step2 -.-> SP_Loop
    SP_Update -.-> Step2

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step2,Step3,RD_Validate,RD_Empty,RD_Title,RD_Normalize,RD_Split,SP_Loop,SP_State,SP_Slice,SP_Direct,SP_Recurse,SP_Append,SP_Update processNode;
    class RD_Read,SP_Fence,SP_CheckTitle,SP_Judge decisionNode;
