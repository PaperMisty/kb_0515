---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef dbNode fill:#E8F5E9,stroke:#2E7D32,stroke-width:1.5px,color:#1B5E20;

    subgraph Main [NodeMDImg process 流程]
        Start(["开始: process state"])
        Step1("调用 get_img 探测并读取 md_path 的本地 images 列表")
        Step2{"images 列表是否为空?"}
        End_State(["直接返回原 state 状态"])
        Step3("调用 get_img_context 基于正则表达式筛选匹配 md 引用的图片")
        Step4{"引用的图片上下文列表是否为空?"}
        Step5("调用 get_img_abstract 获取多模态 VLM 提取的图片中文摘要")
        Step6("调用 upload_img_minio 幂等删除并直传 MinIO 以拼装线上 url")
        Step7("调用 replace_md_content 按照 span 降序由后往前覆写 md 文本并写磁盘")
        End(["返回新 md_content 和 md_path"])

        Start --> Step1
        Step1 --> Step2
        Step2 -- 是 --> End_State
        Step2 -- 否 --> Step3
        Step3 --> Step4
        Step4 -- 是 --> End_State
        Step4 -- 否 --> Step5
        Step5 --> Step6
        Step6 --> Step7
        Step7 --> End
        End_State -.-> End
    end

    subgraph VLM_Abstract [get_img_abstract 图片多模态摘要逻辑]
        direction TD
        RC_VLM("初始化 VLM 多模态大模型客户端")
        RC_Loop("遍历 img_context_list 行记录")
        RC_B64("读取本地图片二进制，并将其进行 base64 字符串编码")
        RC_Msg("构建包含图片数据与前后上下文的 user/system messages 提示词列表")
        RC_Batch{"列表数达 llm_batch=30 或者是最后一项?"}
        RC_Async[("调用 chat_batch 异步限流令牌桶控制并发推理")]
        RC_Fill("引用解析回填给 img_context 增加 img_summary 属性")
        RC_Clean("清空当前批次缓存")
        RC_Ret("返回带摘要的图片列表")

        RC_VLM --> RC_Loop
        RC_Loop --> RC_B64
        RC_B64 --> RC_Msg
        RC_Msg --> RC_Batch
        RC_Batch -- 否 --> RC_Loop
        RC_Batch -- 是 --> RC_Async
        RC_Async --> RC_Fill
        RC_Fill --> RC_Clean
        RC_Clean --> RC_Loop
        RC_Loop -- 遍历完毕 --> RC_Ret
    end

    %% 模块交互连线
    Step5 -.-> RC_VLM
    RC_Ret -.-> Step5

    %% 样式绑定应用
    class Start,End,End_State startEnd;
    class Step1,Step3,Step5,Step6,Step7,RC_VLM,RC_Loop,RC_B64,RC_Msg,RC_Fill,RC_Clean,RC_Ret processNode;
    class Step2,Step4,RC_Batch decisionNode;
    class RC_Async dbNode;
