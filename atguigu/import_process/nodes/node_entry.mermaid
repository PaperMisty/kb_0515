---
config:
  theme: base
  themeVariables:
    fontFamily: "TimesNewRoman"
    fontSize: "22px"
    primaryBorderColor: "#0062ffff"
---

flowchart LR
    %% 节点样式类定义
    classDef startEnd fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef processNode fill:#F5F5F5,stroke:#424242,stroke-width:1px,color:#212121;
    classDef decisionNode fill:#FFF8E1,stroke:#FF8F00,stroke-width:1.5px,color:#E65100;
    classDef errorNode fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;

    subgraph Main [NodeEntry process 任务分发流程]
        Start(["开始: process state"])
        Step1("获取 state 中的 local_file_path")
        Check_Path{"检查 local_file_path 是否有效?"}
        Err_Path("抛出 KeyError 异常")
        Step2("解析文件名 file_name 和后缀 file_type")
        Check_Type{"检查 file_type 文件类型"}
        Step_MD("更新状态: 启用 Markdown 读取器")
        Step_PDF("更新状态: 启用 PDF 解析器")
        Err_Type("抛出 ValueError 异常: 不支持的类型")
        End(["返回更新后的 state"])

        Start --> Step1
        Step1 --> Check_Path
        Check_Path -- 无效/不存在 --> Err_Path
        Check_Path -- 有效 --> Step2
        Step2 --> Check_Type
        Check_Type -- ".md" --> Step_MD
        Check_Type -- ".pdf" --> Step_PDF
        Check_Type -- 其他 --> Err_Type
        Step_MD --> End
        Step_PDF --> End
        Err_Path -.-> End
        Err_Type -.-> End
    end

    %% 样式绑定应用
    class Start,End startEnd;
    class Step1,Step2,Step_MD,Step_PDF processNode;
    class Check_Path,Check_Type decisionNode;
    class Err_Path,Err_Type errorNode;
